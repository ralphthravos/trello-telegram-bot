# ── Telegram ──────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_group_chat_id_here

# ── Trello ────────────────────────────────────────────────
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_board_id

# ── Optional: default list for /task command (must match exact Trello list name)
# DEFAULT_LIST_NAME=To Do

# ── Optional: cron schedule for daily report (default: 8:00 AM Eastern Time)
# REPORT_CRON=0 8 * * *
# REPORT_TZ=America/New_York

# ── Optional: comma-separated names of "done" lists to exclude from report
# DONE_LIST_NAMES=Done,Complete,Finished,Closed
